# mount point    fstype    device                       device2                 flags
/recovery         emmc     /dev/block/platform/bootdevice/by-name/recovery      flags=backup=1;display="Recovery";flashimg=1
/boot             emmc     /dev/block/platform/bootdevice/by-name/boot          flags=backup=1;display="Boot";flashimg=1
/cache            ext4     /dev/block/platform/bootdevice/by-name/cache         flags=display="Cache";wipeingui
/dtbo             emmc     /dev/block/platform/bootdevice/by-name/dtbo          flags=backup=1;display="DTBO";flashimg=1
/persist          ext4     /dev/block/platform/bootdevice/by-name/persist       flags=display="Persist"
/storage       	  ext4     /data/media/0                  		       flags=display="Internal Storage";usermrf;backup=1;fsflags="bind";removable

# Vbmeta
/vbmeta           emmc     /dev/block/platform/bootdevice/by-name/vbmeta        flags=backup=1;display="VBMeta";flashimg=1
/vbmeta_system    emmc     /dev/block/platform/bootdevice/by-name/vbmeta_system	flags=backup=1;display="VBMeta System";flashimg=1
/vbmeta_vendor	  emmc     /dev/block/platform/bootdevice/by-name/vbmeta_vendor	flags=backup=1;display="VBMeta Vendor";flashimg=1

# vivo partition
/vgc              ext4     /dev/block/platform/bootdevice/by-name/vgc           flags=display="Vgc"
/oem              ext4     /dev/block/platform/bootdevice/by-name/cust          flags=display="Oem"

# IMEI and modem related
# below four partitions are ext4, but we are using only for backup so emmc
/protect_f        emmc     /dev/block/platform/bootdevice/by-name/protect1      flags=backup=1;display="Protect1"
/protect_s        emmc     /dev/block/platform/bootdevice/by-name/protect2      flags=backup=1;display="Protect2"
/nvdata           emmc     /dev/block/platform/bootdevice/by-name/nvdata        flags=backup=1;display="Nvdata"
/nvcfg            emmc     /dev/block/platform/bootdevice/by-name/nvcfg         flags=backup=1;display="Nvcfg"
/nvram            emmc     /dev/block/platform/bootdevice/by-name/nvram         flags=backup=1;display="Nvram"
/proinfo          emmc     /dev/block/platform/bootdevice/by-name/proinfo       flags=backup=1;display="Proinfo"

# Dynamic vivo
/system           ext4     /dev/block/mapper/system                             flags=display="System";backup=0;wipeingui;
/product          ext4     /dev/block/mapper/product                            flags=display="Product";backup=0;wipeingui;
/vendor           ext4     /dev/block/mapper/vendor                             flags=display="Vendor";backup=0;wipeingui;

# Partition image
/persist_image    emmc     /dev/block/platform/bootdevice/by-name/persist       flags=backup=1;display="Persist Image";flashimg=1
/system_image     emmc     /dev/block/mapper/system                             flags=backup=1;display="System Image";flashimg=1
/product_image    emmc     /dev/block/mapper/product                            flags=backup=1;display="Product Image";flashimg=1
/vendor_image     emmc     /dev/block/mapper/vendor                             flags=backup=1;display="Vendor Image";flashimg=1

# Removable storage
/sdcard1          vfat     /dev/block/mmcblk1p1  /dev/block/mmcblk1             flags=display="MicroSD";storage;wipeingui;removable;fsflags="utf8"
/usb_otg          auto     /dev/block/sda1  /dev/block/sda                      flags=display="USB Storage";storage;wipeingui;removable;fsflags="utf8"
