#<src>                                            <mnt_point>  <type>  <mnt_flags and options>                                                  <fs_mgr_flags>
/dev/block/mapper/system                          /system      ext4    ro                                                                       wait,avb=vbmeta_system,logical,first_stage_mount
/dev/block/mapper/vendor                          /vendor      ext4    ro                                                                       wait,logical,avb,first_stage_mount
/dev/block/mapper/product                         /product     ext4    ro                                                                       wait,avb,logical,first_stage_mount
/dev/block/platform/bootdevice/by-name/cust       /oem         ext4    ro                                                                       wait,,first_stage_mount
/dev/block/platform/bootdevice/by-name/vgc        /vgc         ext4    ro                                                                       wait,,first_stage_mount

/dev/block/platform/bootdevice/by-name/userdata   /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,discard,errors=panic,inlinecrypt    latemount,wait,check,quota,reservedsize=128M,formattable,resize,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v1
/dev/block/platform/bootdevice/by-name/metadata   /metadata    ext4    noatime,nosuid,nodev,discard                                             wait,check,formattable,first_stage_mount
/dev/block/platform/bootdevice/by-name/para       /misc        emmc    defaults                                                                 defaults
